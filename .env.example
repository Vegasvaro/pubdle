# Copia este archivo a `.env.local` y rellena los valores.
# Vite expone al cliente cualquier variable que empiece por VITE_.

# --- Supabase (autenticación de usuarios) ---
# 1) Crea un proyecto gratis en https://supabase.com
# 2) Project Settings → API → "Project URL" y "anon public" key
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional: para habilitar login con Google añade un OAuth provider en
# Supabase → Authentication → Providers → Google.

# --- NCBI E-utilities API key (opcional pero recomendado) ---
# Sin clave: 3 req/seg. Con clave: 10 req/seg.
# NO lleva prefijo VITE_: se usa SOLO en el servidor (Vercel Function o
# proxy de Vite en dev), nunca se expone en el bundle del navegador.
# Crear en https://account.ncbi.nlm.nih.gov/settings/ → API Key Management
NCBI_API_KEY=
